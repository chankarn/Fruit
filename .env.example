# ─── Local Dev (จาก `npm run db:start`) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-from-supabase-start-output>

# ─── Production (จาก Supabase Dashboard → Project Settings → API) ────────────
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️  SERVICE ROLE KEY — ใช้ฝั่ง server เท่านั้น ห้าม commit ค่าจริงลง Git
# ตั้งเป็น Secret ใน Vercel Dashboard และ GitHub Actions Secrets เท่านั้น
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
